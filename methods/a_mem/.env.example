# 复制到仓库根目录 .env.local，在本地填写；不要把密钥发到聊天或提交 Git。
AMEM_API_KEY=
# 服务地址，通常以 /v1 结尾，以服务商提供的 OpenAI 兼容地址为准。
AMEM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 聊天模型名称（负责分析和演化记忆）。
AMEM_LLM_MODEL=qwen-flash
# Embedding 模型名称（负责检索向量）；不能填写聊天模型名称。
AMEM_EMBEDDING_MODEL=text-embedding-v4
# 可选：Embedding 使用不同服务地址时填写，空白则沿用 AMEM_BASE_URL。
AMEM_EMBEDDING_BASE_URL=
# 可选：仅当服务商要求显式指定输出维度时填写整数，空白则使用模型默认维度。
AMEM_EMBEDDING_DIMS=1024
